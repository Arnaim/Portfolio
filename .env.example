# Firebase web client configuration (public by design — not secrets).
# These values identify the Firebase project so the SERVER can read public
# Firestore data through the public REST API. Firestore Security Rules remain
# the real protection — never rely on hiding these values.
#
# Copy this file to `.env` for local dev, and set the same vars in
# Netlify → Site settings → Environment variables for production.

# Public Firebase web API key (from Firebase console → Project settings → Web app)
FIREBASE_API_KEY=AIzaSyC8Fyb9WRrlTwtLxTcS4cbiuXL01kYP4cM

# Firebase project ID
FIREBASE_PROJECT_ID=arnab-portfolio-844d1

# Canonical production URL (used for canonical tags, sitemap, OG URLs)
SITE_URL=https://naimurrahmanportfolio.netlify.app
