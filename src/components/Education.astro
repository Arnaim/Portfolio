---
/**
 * Education — compact editorial section between About and Capabilities.
 * Reuses the design system: numbered mono label, display heading sized to fit
 * its narrow column (text-big, not text-huge), and the ruled dl metadata rows
 * from the project-detail sidebar. Long strings (degree, university) are NOT
 * uppercased so they wrap cleanly instead of colliding.
 */
import { EDUCATION } from '../types/site';
---

<section id="education" aria-labelledby="education-heading" class="relative overflow-hidden border-b-2 border-ink py-20 md:py-28">
  <!-- Decorative composition (kept to the corners, clear of all text) -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 select-none">
    <div class="mark-plus absolute top-10 right-[6%] h-5 w-5 text-ink/40"></div>
    <div class="bg-dots-ink absolute bottom-8 left-[2%] h-16 w-32 opacity-15"></div>
    <div class="absolute right-[12%] bottom-[18%] h-3 w-3 rotate-45 bg-vermilion/50"></div>
  </div>

  <div class="container-ed relative grid gap-12 md:grid-cols-12">
    <div class="md:col-span-4">
      <p class="label-mono">03 — Education</p>
      <h2 id="education-heading" class="mt-3 font-display text-big font-black uppercase">
        Academics<span aria-hidden="true" class="text-vermilion">.</span>
      </h2>
      <p class="mt-6 max-w-xs text-ink-soft">
        Four years of computer science — from data structures and algorithms to
        the machine-learning thesis I'm finishing now.
      </p>
    </div>

    <div class="md:col-span-8">
      <div class="border-t-2 border-ink pt-6">
        <h3 class="max-w-2xl font-display text-2xl font-black leading-tight md:text-3xl">
          {EDUCATION.degree}
        </h3>
        <p class="mt-2 text-lg text-ink-soft">
          {EDUCATION.university}
          <span class="label-mono ml-1">({EDUCATION.universityShort})</span>
        </p>

        <dl class="mt-8 grid gap-x-10 gap-y-6 border-t border-ink/20 pt-6 sm:grid-cols-2">
          <div>
            <dt class="label-mono">Years</dt>
            <dd class="mt-1 font-display text-lg font-bold">{EDUCATION.years}</dd>
          </div>
          <div>
            <dt class="label-mono">CGPA</dt>
            <dd class="mt-1 font-display text-lg font-bold">{EDUCATION.cgpa}</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>
