---
/** Contact CTA: oversized invitation + direct channels. */
import { SITE } from '../types/site';
---

<section id="contact" aria-labelledby="contact-heading" class="border-t-2 border-ink bg-vermilion text-paper">
  <div class="container-ed py-20 md:py-28">
    <p class="label-mono !text-paper/70">04 — Contact</p>
    <h2 id="contact-heading" class="mt-3 max-w-4xl font-display text-huge font-black uppercase">
      Let's make something<span aria-hidden="true">.</span>
    </h2>
    <p class="mt-6 max-w-xl text-lg text-paper/85">
      Have a project idea, a question, or want to say hi? The inbox is open.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href={`mailto:${SITE.email}`}
        class="border-2 border-paper bg-paper px-7 py-4 font-mono text-sm font-bold tracking-widest text-ink uppercase shadow-block !shadow-[6px_6px_0_0_#1c1a17] hover:-translate-x-0.5 hover:-translate-y-0.5"
      >
        {SITE.email}
      </a>
      <a
        href="/contact"
        class="border-2 border-paper px-7 py-4 font-mono text-sm font-bold tracking-widest uppercase hover:bg-paper/10"
      >
        Contact page →
      </a>
    </div>
  </div>
</section>
