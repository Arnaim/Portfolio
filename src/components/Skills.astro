---
/**
 * Skills as an editorial index — a ruled table with oversized row numbers,
 * not a cloud of pills. Data comes from types/site.ts (migrated content).
 */
import { SKILLS } from '../types/site';
---

<section aria-labelledby="skills-heading" class="relative overflow-hidden border-y-2 border-ink bg-ultra-soft/30 py-20 md:py-28">
  <!-- Decorative composition (hidden from AT) -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 select-none">
    <!-- circle outline, top right -->
    <div class="shape-spin absolute -top-10 right-[6%] h-28 w-28 rounded-full border-[5px] border-vermilion/80"></div>
    <!-- dot field, bottom left -->
    <div class="bg-dots-ink absolute bottom-8 left-[4%] h-24 w-44 opacity-20"></div>
    <!-- solid triangle, upper area -->
    <svg class="absolute top-12 left-[38%] h-8 w-8 text-ultra" viewBox="0 0 40 40">
      <path d="M20 2 38 38 2 38Z" fill="currentColor"></path>
    </svg>
  </div>
  <div class="container-ed relative grid gap-12 md:grid-cols-12">
    <div class="md:col-span-4">
      <p class="label-mono">03 — Capabilities</p>
      <h2 id="skills-heading" class="mt-3 font-display text-huge font-black uppercase">
        Tool<span class="text-vermilion" aria-hidden="true">·</span>box
      </h2>
      <p class="mt-6 max-w-xs text-ink-soft">
        Languages, frameworks and systems I use to take software from idea to release.
      </p>
    </div>

    <div class="md:col-span-8">
      {
        SKILLS.map((group, gi) => (
          <div class="border-t-2 border-ink py-7 last:border-b-2">
            <div class="flex items-baseline gap-5">
              <span aria-hidden="true" class="font-display text-3xl font-black text-vermilion">
                {String(gi + 1).padStart(2, '0')}
              </span>
              <h3 class="font-mono text-sm font-bold tracking-[0.2em] uppercase">{group.group}</h3>
            </div>
            <ul class="mt-4 flex flex-wrap gap-2.5">
              {group.items.map((item) => (
                <li class="border border-ink/60 px-3 py-1.5 font-mono text-xs tracking-wide">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
