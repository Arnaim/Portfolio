---
/** About: editorial two-column with framed portrait, oversized pull-quote styling. */
import { SITE, ABOUT } from '../types/site';

interface Props {
  /** cert list can be hidden on the homepage if space is tight */
  withCerts?: boolean;
}
const { withCerts = true } = Astro.props;
---

<section id="about" aria-labelledby="about-heading" class="relative overflow-hidden border-y-2 border-ink bg-ultra-soft/40">
  <!-- Decorative composition (hidden from AT) -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 select-none">
    <!-- diagonal rule behind the portrait -->
    <div class="absolute top-[30%] left-[-2%] h-[3px] w-48 -rotate-[24deg] bg-ink/70 md:w-64"></div>
    <!-- dot field, bottom right -->
    <div class="bg-dots-ink absolute right-[6%] bottom-10 h-24 w-48 opacity-20"></div>
    <!-- outline square, top left -->
    <div class="absolute top-10 left-[2%] h-14 w-14 -rotate-6 border-[3px] border-ultra/60"></div>
  </div>
  <div class="container-ed relative grid gap-14 py-20 md:grid-cols-12 md:py-28">
    <!-- Portrait block (geometric framing instead of the old circular avatar) -->
    <div class="md:col-span-4">
      <div class="relative">
        <div aria-hidden="true" class="absolute -top-4 -left-4 h-24 w-24 rounded-full bg-vermilion"></div>
        <div aria-hidden="true" class="absolute -right-3 -bottom-3 h-16 w-16 rounded-full border-[4px] border-ultra"></div>
        <div class="relative aspect-[4/5] overflow-hidden border-2 border-ink bg-paper-deep shadow-block">
          <img
            src="/profile.jpeg"
            alt={`Portrait of ${SITE.name}`}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
        <p class="label-mono mt-4">{SITE.name} — Dhaka, Bangladesh</p>
      </div>
    </div>

    <!-- Text block -->
    <div class="md:col-span-8">
      <p class="label-mono">02 — About</p>
      <h2 id="about-heading" class="mt-3 font-display text-huge font-black uppercase">
        {ABOUT.heading}<span aria-hidden="true" class="text-ultra">.</span>
      </h2>

      <div class="mt-8 max-w-prose space-y-5 text-lg text-ink-soft">
        {ABOUT.paragraphs.map((para) => <p>{para}</p>)}
      </div>

      {
        withCerts && (
          <div class="mt-12">
            <p class="label-mono mb-5">Certificates & honors</p>
            <ul class="grid gap-x-10 gap-y-3 sm:grid-cols-2">
              {ABOUT.certs.map((cert) => (
                <li class="flex items-baseline gap-3 border-b border-ink/20 pb-2">
                  <span aria-hidden="true" class="mt-1 inline-block h-2.5 w-2.5 shrink-0 bg-vermilion" />
                  <span>
                    {cert.title}
                    <span class="label-mono ml-2">{cert.issuer}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</section>
