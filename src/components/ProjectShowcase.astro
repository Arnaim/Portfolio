---
/**
 * Editorial work showcase — NOT a card grid.
 *
 * Composition system (spec §17): each project is a numbered entry whose
 * layout rotates through three variants so the page reads like a curated
 * magazine feature list. Works with ANY number of projects (1…n):
 * - variant A: large visual left / text right
 * - variant B: text left / visual right, vertically offset
 * - variant C: full-width horizontal editorial strip
 */
import type { Project } from '../types/project';
import { projectHref } from '../lib/projects';
import ProjectImage from './ProjectImage.astro';

interface Props {
  projects: Project[];
  /** Show the "View all projects" footer link. */
  withViewAll?: boolean;
}

const { projects, withViewAll = false } = Astro.props;

const num = (i: number) => String(i + 1).padStart(2, '0');
const variantOf = (i: number) => i % 3; // 0 = A, 1 = B, 2 = C
---

<section id="work" aria-labelledby="work-heading" class="container-ed py-20 md:py-28">
  <div class="mb-14 flex flex-wrap items-end justify-between gap-6">
    <div>
      <p class="label-mono">Index — Selected work</p>
      <h2 id="work-heading" class="mt-3 font-display text-huge font-black uppercase">
        Work<span aria-hidden="true" class="text-vermilion">.</span>
      </h2>
    </div>
    <p class="label-mono max-w-xs text-right">
      {projects.length} project{projects.length === 1 ? '' : 's'} — managed in Firestore, rendered as HTML
    </p>
  </div>

  {projects.length === 0 && (
    <p class="border-2 border-dashed border-ink/40 p-10 text-center text-ink-soft">
      Projects are being updated — check back shortly.
    </p>
  )}

  <ol class="list-none space-y-20 md:space-y-28">
    {
      projects.map((p, i) => {
        const variant = variantOf(i);
        const href = projectHref(p);

        const meta = (
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
            <span class="label-mono">{p.year ?? `Nº ${num(i)}`}</span>
            {p.status && <span class="label-mono">{p.status}</span>}
            {p.techStack && p.techStack.length > 0 && (
              <span class="label-mono">{p.techStack.slice(0, 4).join(' · ')}</span>
            )}
          </div>
        );

        const text = (
          <div class="flex h-full flex-col justify-center">
            <p class="label-mono mb-4" aria-hidden="true">
              {num(i)} {p.category ? `— ${p.category}` : ''}
            </p>
            <h3 class="font-display text-big font-black uppercase leading-none">
              <a href={href} class="hover:text-vermilion-deep">
                {p.title}
              </a>
            </h3>
            <p class="mt-4 max-w-prose text-ink-soft">{p.description}</p>
            {meta}
            <div class="mt-6 flex flex-wrap items-center gap-4">
              <a href={href} class="font-mono text-sm font-bold tracking-widest uppercase underline decoration-vermilion decoration-2 underline-offset-4 hover:text-vermilion-deep">
                Case study →
              </a>
              {p.liveUrl && (
                <a href={p.liveUrl} rel="noopener noreferrer" class="label-mono hover:text-vermilion-deep">
                  Live ↗
                </a>
              )}
              {p.githubUrl && (
                <a href={p.githubUrl} rel="noopener noreferrer" class="label-mono hover:text-vermilion-deep">
                  GitHub ↗
                </a>
              )}
            </div>
          </div>
        );

        const image = (
          <a href={href} tabindex={-1} aria-hidden="true" class:list={['group block', variant === 1 && 'md:mt-10']}>
            <div class="relative">
              <ProjectImage
                src={p.imageUrl}
                alt=""
                aspect={variant === 2 ? 'aspect-[16/9] md:aspect-[2/1]' : 'aspect-[4/3]'}
                eager={i < 2}
              />
              <span
                aria-hidden="true"
                class:list={[
                  'absolute -top-6 z-10 font-display font-black text-vermilion',
                  'text-7xl md:text-8xl',
                  variant === 0 ? '-left-4' : 'left-auto -right-4',
                ]}
              >
                {num(i)}
              </span>
            </div>
          </a>
        );

        return (
          <li class="reveal">
            {variant === 0 && (
              <article class="grid items-center gap-8 md:grid-cols-12 md:gap-12">
                <div class="md:col-span-7">{image}</div>
                <div class="md:col-span-5">{text}</div>
              </article>
            )}
            {variant === 1 && (
              <article class="grid items-center gap-8 md:grid-cols-12 md:gap-12">
                <div class="order-2 md:order-1 md:col-span-5">{text}</div>
                <div class="order-1 md:order-2 md:col-span-7">{image}</div>
              </article>
            )}
            {variant === 2 && (
              <article class="border-y-2 border-ink py-10">
                <div class="grid gap-8 md:grid-cols-12 md:gap-12 md:items-center">
                  <div class="md:col-span-5">{image}</div>
                  <div class="md:col-span-7">{text}</div>
                </div>
              </article>
            )}
          </li>
        );
      })
    }
  </ol>

  {
    withViewAll && projects.length > 0 && (
      <div class="mt-20 text-center">
        <a
          href="/projects"
          class="inline-block border-2 border-ink bg-ink px-8 py-4 font-mono text-sm font-bold tracking-widest text-paper uppercase shadow-block-vermilion transition-transform hover:-translate-x-0.5 hover:-translate-y-0.5"
        >
          All projects →
        </a>
      </div>
    )
  }
</section>
