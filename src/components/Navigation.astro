---
/**
 * Editorial navigation. Simple inline links on desktop, a native-friendly
 * details/summary menu on mobile (no JS required, fully keyboard accessible).
 */
import { SITE } from '../types/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/contact', label: 'Contact' },
] as const;

const isActive = (href: string) => {
  const bare = href.split('#')[0] || '/';
  if (bare === '/') return currentPath === '/';
  return currentPath.startsWith(bare);
};
---

<header class="sticky top-0 z-50 border-b-2 border-ink bg-paper/95 backdrop-blur-sm">
  <nav aria-label="Primary" class="container-ed flex h-16 items-center justify-between gap-4">
    <a
      href="/"
      class="font-display text-lg font-black tracking-tight uppercase"
      aria-label={`${SITE.name} — home`}
    >
      NRA<span aria-hidden="true" class="text-vermilion">.</span>
      <span class="label-mono ml-2 hidden sm:inline">/ {SITE.name}</span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-6 md:flex">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              class="label-mono relative py-2 hover:text-ink aria-[current=page]:text-vermilion-deep"
            >
              {label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={SITE.cvPath}
          class="label-mono border-2 border-ink px-3 py-2 font-bold text-ink transition-colors hover:bg-ink hover:text-paper"
          download
        >
          CV ↓
        </a>
      </li>
    </ul>

    <!-- Mobile menu: native <details>, no JS -->
    <details class="group relative md:hidden">
      <summary
        class="label-mono flex cursor-pointer list-none items-center gap-2 border-2 border-ink px-3 py-2 select-none"
        aria-label="Open menu"
      >
        Menu
        <span aria-hidden="true" class="transition-transform group-open:rotate-45">+</span>
      </summary>
      <ul class="absolute right-0 mt-2 w-48 border-2 border-ink bg-paper shadow-block">
        {
          links.map(({ href, label }) => (
            <li class="border-b border-ink/15 last:border-b-0">
              <a href={href} class="label-mono block px-4 py-3 hover:bg-paper-deep" aria-current={isActive(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
        <li class="border-t-2 border-ink">
          <a href={SITE.cvPath} class="label-mono block bg-vermilion-soft px-4 py-3 font-bold" download>
            CV ↓
          </a>
        </li>
      </ul>
    </details>
  </nav>
</header>
