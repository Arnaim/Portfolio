---
/**
 * Base layout: semantic shell + complete SEO metadata + JSON-LD.
 * All metadata is required except ogImage (falls back to /og-image.png).
 */
import '../styles/global.css';
import { SITE_URL, absoluteUrl } from '../lib/site';
import { SITE } from '../types/site';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Path only — canonical/OG URLs are made absolute automatically. */
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  /** Extra JSON-LD blocks to inject after the default WebSite/Person graph. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path, ogImage = '/og-image.png', ogType = 'website', jsonLd = [] } = Astro.props;

const canonical = absoluteUrl(path);
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : absoluteUrl(ogImage);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE_URL,
  jobTitle: SITE.role,
  email: `mailto:${SITE.email}`,
  sameAs: [SITE.github, SITE.linkedin],
  knowsAbout: ['Flutter', 'Dart', 'AI integration', 'REST APIs', 'Firebase', 'Web development'],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${SITE.name} — Portfolio`,
  url: SITE_URL,
};

const schemaBlocks = [personSchema, websiteSchema, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={SITE.name} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content={`${SITE.name} — portfolio`} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Fonts: preconnect + stylesheet (display=swap keeps text visible during load) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&family=Inter:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaBlocks)} />
  </head>
  <body>
    <a
      href="#main"
      class="label-mono fixed left-4 top-4 z-100 -translate-y-24 border-2 border-ink bg-paper px-3 py-2 transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>
    <Navigation currentPath={Astro.url.pathname} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <!-- Progressive enhancement: reveal-on-scroll. Content is fully visible without JS. -->
    <script>
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
