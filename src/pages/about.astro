---
/** About page: full editorial bio + certificates. */
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import ContactCta from '../components/ContactCta.astro';
import { SITE } from '../types/site';
---

<BaseLayout
  title={`About — ${SITE.name}`}
  description={`Who is ${SITE.name}: Computer Science graduate, Flutter developer, AI tinkerer. Background, certificates and approach.`}
  path="/about"
  ogType="profile"
>
  <section aria-labelledby="about-page-heading" class="border-b-2 border-ink">
    <div class="container-ed py-16 md:py-24">
      <p class="label-mono">Profile</p>
      <h1 id="about-page-heading" class="mt-3 font-display text-huge font-black uppercase">
        About<span aria-hidden="true" class="text-ultra">.</span>
      </h1>
      <p class="mt-4 max-w-xl text-lg text-ink-soft">
        {SITE.roleLong} — building software end-to-end, from data model to interface.
      </p>
    </div>
  </section>

  <About withCerts />

  <Skills />
  <ContactCta />
</BaseLayout>
